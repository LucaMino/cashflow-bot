# --- Telegram ---
TG_TOKEN=123456:ABC-DEF...            # from @BotFather
TG_WEBHOOK_SECRET=change-me           # random string: openssl rand -hex 32
TG_ALLOWED_IDS=123456789              # your user id (from @userinfobot); multiple ids comma-separated
WEBHOOK_URL=https://cashflow-bot-<yourname>.fly.dev   # only needed in webhook mode, not with "poll"

# --- Server ---
PORT=8080

# --- LLM ---
LLM_MODEL=gemini/gemini-3.8-flash
# Only one key, for the chosen provider (litellm reads it from os.environ):
GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...

# --- Google Sheets ---
SHEET_ID=...                          # the part of the URL between /d/ and /edit
SHEET_TAB=...                         # the name of the tab in the sheet
CATEGORIES=Food,Transport,Other       # comma-separated, must match the sheet values exactly
PAYMENT_METHODS=Contanti,Carta        # comma-separated, must match the sheet values exactly; must include "Contanti" (default)
# service account JSON on ONE line, in single quotes
GOOGLE_SA_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}'